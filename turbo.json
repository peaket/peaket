{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".next-*/**",
        "!.next-*/cache/**",
        "dist/**"
      ],
      "env": [
        "PEAKET_NEXT_DIST",
        "PEAKET_POC"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/api/**",
        "$TURBO_ROOT$/docs/observability.md",
        "$TURBO_ROOT$/tools/ci/service-openapi.mjs",
        "$TURBO_ROOT$/docs/design/tokens.json",
        "$TURBO_ROOT$/docs/design/d2-design-system.md",
        "$TURBO_ROOT$/docs/frontend.md"
      ],
      "outputs": [
        "test-report.json",
        "test-report.xml"
      ],
      "env": [
        "PEAKET_TEST_REPORT",
        "NODE_OPTIONS"
      ],
      "dependsOn": [
        "^build"
      ]
    },
    "size": {
      "dependsOn": [
        "build"
      ],
      "outputs": []
    }
  }
}
