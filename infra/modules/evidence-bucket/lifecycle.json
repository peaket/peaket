{
  "Rules": [
    {
      "ID": "evidence-standard-expire",
      "Status": "Enabled",
      "Filter": { "Tag": { "Key": "peaket-retention", "Value": "standard" } },
      "Expiration": { "Days": 14 }
    },
    {
      "ID": "evidence-hold-expire",
      "Status": "Enabled",
      "Filter": { "Tag": { "Key": "peaket-retention", "Value": "hold" } },
      "Expiration": { "Days": 30 }
    },
    {
      "ID": "evidence-cleanup",
      "Status": "Enabled",
      "Filter": { "Prefix": "" },
      "Expiration": { "ExpiredObjectDeleteMarker": true },
      "NoncurrentVersionExpiration": { "NoncurrentDays": 1 },
      "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 1 }
    }
  ]
}
