# terraform.tfvars로 복사해 값을 채운다(terraform.tfvars는 커밋하지 않는다).
# 토큰은 여기 적지 않고 GITHUB_TOKEN 환경 변수로 준다.
github_owner = "peaket"
owner_login  = "your-github-login"

# prod 배포 승인자(GitHub 사용자 ID, 숫자). 1인 기간에는 소유자 한 사람이다. ID는 gh api user --jq .id로 본다
prod_reviewer_user_ids = [1234567]

# 릴리스 봇 GitHub 앱을 만든 뒤 그 앱 ID를 넣는다
# release_bot_app_id = 123456
