{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "PEAKET 디자인 토큰. 토대는 SEED Design(당근, Apache-2.0)의 토큰이고(ADR-0040, 2026-10-11) 브랜드 인디고와 휠체어석 자홍은 PEAKET 확장 팔레트다. 값은 SEED 저장소 packages/rootage/__generated__(색 토큰 갱신일 26-06-15)에서 옮겼고 $extensions.seed에 원본 토큰 이름을 적는다. SEED 팔레트는 라이트·다크 값이 다른 적응형 팔레트라 primitive(라이트)와 primitive-dark(다크)를 따로 둔다. WCAG 2.2 AA 대비는 d2 §5에서 계산했고, SEED의 APCA 기준과 달라 라이트의 성공·경고·위험 문구색은 800 단계, 포커스 링은 indigo.500을 쓴다. 원문 근거: 6장(Style Dictionary 단일 소스 → CSS 변수 + Tailwind @theme + TS 상수, 색각이상 안전 팔레트 + 패턴), 9장(모션 토큰), 13장(대비 4.5:1), d1 브레이크포인트.",
  "color": {
    "primitive": {
      "$description": "라이트 팔레트. gray·green·yellow·red·blue는 SEED $color.palette.*(theme-light), indigo·magenta는 PEAKET 확장. SEED의 carrot·purple은 쓰지 않는다(당근 브랜드 색, ADR-0040)",
      "gray": {
        "0": { "$type": "color", "$value": "#ffffff", "$extensions": { "seed": "$color.palette.gray-00" } },
        "100": { "$type": "color", "$value": "#f7f8f9", "$extensions": { "seed": "$color.palette.gray-100" } },
        "200": { "$type": "color", "$value": "#f3f4f5", "$extensions": { "seed": "$color.palette.gray-200" } },
        "300": { "$type": "color", "$value": "#eeeff1", "$extensions": { "seed": "$color.palette.gray-300" } },
        "400": { "$type": "color", "$value": "#dcdee3", "$extensions": { "seed": "$color.palette.gray-400" } },
        "500": { "$type": "color", "$value": "#d1d3d8", "$extensions": { "seed": "$color.palette.gray-500" } },
        "600": { "$type": "color", "$value": "#b0b3ba", "$extensions": { "seed": "$color.palette.gray-600" } },
        "700": { "$type": "color", "$value": "#868b94", "$extensions": { "seed": "$color.palette.gray-700" } },
        "800": { "$type": "color", "$value": "#555d6d", "$extensions": { "seed": "$color.palette.gray-800" } },
        "900": { "$type": "color", "$value": "#2a3038", "$extensions": { "seed": "$color.palette.gray-900" } },
        "1000": { "$type": "color", "$value": "#1a1c20", "$extensions": { "seed": "$color.palette.gray-1000" } }
      },
      "green": {
        "100": { "$type": "color", "$value": "#edfaf6", "$extensions": { "seed": "$color.palette.green-100" } },
        "300": { "$type": "color", "$value": "#b9e9d2", "$extensions": { "seed": "$color.palette.green-300" } },
        "700": { "$type": "color", "$value": "#079171", "$extensions": { "seed": "$color.palette.green-700" } },
        "800": { "$type": "color", "$value": "#00745f", "$extensions": { "seed": "$color.palette.green-800" } },
        "900": { "$type": "color", "$value": "#075445", "$extensions": { "seed": "$color.palette.green-900" } }
      },
      "yellow": {
        "100": { "$type": "color", "$value": "#fff7de", "$extensions": { "seed": "$color.palette.yellow-100" } },
        "300": { "$type": "color", "$value": "#fbdc65", "$extensions": { "seed": "$color.palette.yellow-300" } },
        "700": { "$type": "color", "$value": "#9b7821", "$extensions": { "seed": "$color.palette.yellow-700" } },
        "800": { "$type": "color", "$value": "#755b22", "$extensions": { "seed": "$color.palette.yellow-800" } },
        "900": { "$type": "color", "$value": "#4f3e1f", "$extensions": { "seed": "$color.palette.yellow-900" } }
      },
      "red": {
        "100": { "$type": "color", "$value": "#fdf0f0", "$extensions": { "seed": "$color.palette.red-100" } },
        "300": { "$type": "color", "$value": "#fed4d2", "$extensions": { "seed": "$color.palette.red-300" } },
        "700": { "$type": "color", "$value": "#fa342c", "$extensions": { "seed": "$color.palette.red-700" } },
        "800": { "$type": "color", "$value": "#ca1d13", "$extensions": { "seed": "$color.palette.red-800" } },
        "900": { "$type": "color", "$value": "#921708", "$extensions": { "seed": "$color.palette.red-900" } }
      },
      "blue": {
        "$description": "SEED informative 역할. PEAKET은 안내 배너에만 쓰고 문구색으로는 쓰지 않는다(대비 미계산)",
        "100": { "$type": "color", "$value": "#eff6ff", "$extensions": { "seed": "$color.palette.blue-100" } },
        "700": { "$type": "color", "$value": "#217cf9", "$extensions": { "seed": "$color.palette.blue-700" } }
      },
      "indigo": {
        "$description": "PEAKET 브랜드 팔레트(d1 §3, 추천 적용 2026-10-09). SEED의 brand 역할을 이 값으로 덮어쓴다",
        "100": { "$type": "color", "$value": "#DFE2FF" },
        "300": { "$type": "color", "$value": "#A9B0FF" },
        "500": { "$type": "color", "$value": "#5B5BE8" },
        "600": { "$type": "color", "$value": "#4338CA" },
        "700": { "$type": "color", "$value": "#332B9E" },
        "900": { "$type": "color", "$value": "#1C1A55" }
      },
      "magenta": {
        "$description": "PEAKET 확장. 휠체어석 전용(인디고·SEED purple과 색상이 가까워 purple은 쓰지 않음)",
        "300": { "$type": "color", "$value": "#F08FD0" },
        "600": { "$type": "color", "$value": "#A3207E" }
      }
    },
    "primitive-dark": {
      "$description": "다크 팔레트(SEED theme-dark). 같은 이름의 라이트 값과 짝이다. indigo·magenta는 적응형이 아니라 다크 의미 토큰이 밝은 단계를 고른다",
      "gray": {
        "0": { "$type": "color", "$value": "#000000", "$extensions": { "seed": "$color.palette.gray-00" } },
        "100": { "$type": "color", "$value": "#16171b", "$extensions": { "seed": "$color.palette.gray-100" } },
        "200": { "$type": "color", "$value": "#1d2025", "$extensions": { "seed": "$color.palette.gray-200" } },
        "300": { "$type": "color", "$value": "#2b2e35", "$extensions": { "seed": "$color.palette.gray-300" } },
        "400": { "$type": "color", "$value": "#393d46", "$extensions": { "seed": "$color.palette.gray-400" } },
        "500": { "$type": "color", "$value": "#5b606a", "$extensions": { "seed": "$color.palette.gray-500" } },
        "600": { "$type": "color", "$value": "#868b94", "$extensions": { "seed": "$color.palette.gray-600" } },
        "700": { "$type": "color", "$value": "#b0b3ba", "$extensions": { "seed": "$color.palette.gray-700" } },
        "800": { "$type": "color", "$value": "#dcdee3", "$extensions": { "seed": "$color.palette.gray-800" } },
        "900": { "$type": "color", "$value": "#e9eaec", "$extensions": { "seed": "$color.palette.gray-900" } },
        "1000": { "$type": "color", "$value": "#f3f4f5", "$extensions": { "seed": "$color.palette.gray-1000" } }
      },
      "green": {
        "100": { "$type": "color", "$value": "#202926", "$extensions": { "seed": "$color.palette.green-100" } },
        "700": { "$type": "color", "$value": "#22b27f", "$extensions": { "seed": "$color.palette.green-700" } },
        "900": { "$type": "color", "$value": "#93e5c0", "$extensions": { "seed": "$color.palette.green-900" } }
      },
      "yellow": {
        "100": { "$type": "color", "$value": "#302819", "$extensions": { "seed": "$color.palette.yellow-100" } },
        "700": { "$type": "color", "$value": "#ca901c", "$extensions": { "seed": "$color.palette.yellow-700" } },
        "900": { "$type": "color", "$value": "#e5d49b", "$extensions": { "seed": "$color.palette.yellow-900" } }
      },
      "red": {
        "100": { "$type": "color", "$value": "#322323", "$extensions": { "seed": "$color.palette.red-100" } },
        "700": { "$type": "color", "$value": "#ff6e60", "$extensions": { "seed": "$color.palette.red-700" } },
        "900": { "$type": "color", "$value": "#f8c5c3", "$extensions": { "seed": "$color.palette.red-900" } }
      },
      "blue": {
        "100": { "$type": "color", "$value": "#202742", "$extensions": { "seed": "$color.palette.blue-100" } },
        "700": { "$type": "color", "$value": "#41a2f9", "$extensions": { "seed": "$color.palette.blue-700" } }
      }
    },
    "semantic": {
      "$description": "의미 토큰. light와 dark 그룹을 같은 키로 둔다. 코드에서는 SEED의 data-seed-color-mode·data-seed-user-color-scheme 속성으로 고른다(ADR-0040). $extensions.seed는 대응하는 SEED 역할 토큰이고 'override'는 PEAKET이 값을 덮어쓴 역할이다",
      "light": {
        "surface": { "$type": "color", "$value": "{color.primitive.gray.0}", "$extensions": { "seed": "$color.bg.layer-default" } },
        "surface-muted": { "$type": "color", "$value": "{color.primitive.gray.100}", "$extensions": { "seed": "$color.bg.neutral-muted" } },
        "surface-basement": { "$type": "color", "$value": "{color.primitive.gray.200}", "$extensions": { "seed": "$color.bg.layer-basement" }, "$description": "화면 맨 아래 배경. 카드가 그 위에 surface로 올라간다" },
        "surface-raised": { "$type": "color", "$value": "{color.primitive.gray.0}", "$extensions": { "seed": "$color.bg.layer-floating" } },
        "surface-disabled": { "$type": "color", "$value": "{color.primitive.gray.200}", "$extensions": { "seed": "$color.bg.disabled" } },
        "border": { "$type": "color", "$value": "{color.primitive.gray.400}", "$extensions": { "seed": "$color.stroke.neutral-weak" } },
        "border-input": { "$type": "color", "$value": "{color.primitive.gray.800}", "$extensions": { "seed": "$color.stroke.neutral-solid" } },
        "border-primary": { "$type": "color", "$value": "{color.primitive.indigo.600}", "$extensions": { "seed": "$color.stroke.brand-solid", "override": "PEAKET 인디고(ADR-0040)" } },
        "text": { "$type": "color", "$value": "{color.primitive.gray.1000}", "$extensions": { "seed": "$color.fg.neutral" } },
        "text-muted": { "$type": "color", "$value": "{color.primitive.gray.800}", "$extensions": { "seed": "$color.fg.neutral-muted" } },
        "text-disabled": { "$type": "color", "$value": "{color.primitive.gray.500}", "$extensions": { "seed": "$color.fg.disabled" } },
        "text-on-primary": { "$type": "color", "$value": "{color.primitive.gray.0}", "$extensions": { "seed": "$color.fg.on-brand-solid" } },
        "primary": { "$type": "color", "$value": "{color.primitive.indigo.600}", "$extensions": { "seed": "$color.bg.brand-solid", "override": "PEAKET 인디고" } },
        "primary-hover": { "$type": "color", "$value": "{color.primitive.indigo.700}", "$extensions": { "seed": "$color.bg.brand-solid-pressed", "override": "PEAKET 인디고" } },
        "primary-subtle": { "$type": "color", "$value": "{color.primitive.indigo.100}", "$extensions": { "seed": "$color.bg.brand-weak", "override": "PEAKET 인디고" } },
        "link": { "$type": "color", "$value": "{color.primitive.indigo.600}", "$extensions": { "seed": "$color.fg.brand", "override": "PEAKET 인디고" } },
        "success": { "$type": "color", "$value": "{color.primitive.green.800}", "$extensions": { "seed": "$color.fg.positive", "override": "WCAG 4.5:1을 위해 700 대신 800" } },
        "success-subtle": { "$type": "color", "$value": "{color.primitive.green.100}", "$extensions": { "seed": "$color.bg.positive-weak" } },
        "warning": { "$type": "color", "$value": "{color.primitive.yellow.800}", "$extensions": { "seed": "$color.fg.warning", "override": "WCAG 4.5:1을 위해 700 대신 800" } },
        "warning-subtle": { "$type": "color", "$value": "{color.primitive.yellow.100}", "$extensions": { "seed": "$color.bg.warning-weak" } },
        "danger": { "$type": "color", "$value": "{color.primitive.red.800}", "$extensions": { "seed": "$color.fg.critical", "override": "WCAG 4.5:1을 위해 700 대신 800" } },
        "danger-subtle": { "$type": "color", "$value": "{color.primitive.red.100}", "$extensions": { "seed": "$color.bg.critical-weak" } },
        "info-subtle": { "$type": "color", "$value": "{color.primitive.blue.100}", "$extensions": { "seed": "$color.bg.informative-weak" }, "$description": "안내 배너 배경. 글자는 text를 쓴다" },
        "focus-ring": { "$type": "color", "$value": "{color.primitive.indigo.500}", "$extensions": { "seed": "$color.stroke.focus-ring", "override": "SEED blue-600은 흰 배경에서 2.84:1이라 WCAG 1.4.11에 못 미침" } },
        "seat": {
          "$description": "좌석 상태는 색 + 패턴(pattern 토큰)을 함께 쓴다(원문 6장·13장). held-by-others·sold·unavailable은 누를 수 없는 비활성 요소라 WCAG 1.4.11 비활성 예외(d2 §5)",
          "available": { "$type": "color", "$value": "{color.primitive.green.700}", "$extensions": { "seed": "$color.bg.positive-solid" } },
          "held-by-others": { "$type": "color", "$value": "{color.primitive.gray.500}", "$extensions": { "seed": "$color.palette.gray-500" } },
          "mine": { "$type": "color", "$value": "{color.primitive.indigo.600}", "$extensions": { "seed": "$color.bg.brand-solid", "override": "PEAKET 인디고" } },
          "sold": { "$type": "color", "$value": "{color.primitive.gray.800}", "$extensions": { "seed": "$color.palette.gray-800" } },
          "unavailable": { "$type": "color", "$value": "{color.primitive.gray.300}", "$extensions": { "seed": "$color.palette.gray-300" } },
          "wheelchair": { "$type": "color", "$value": "{color.primitive.magenta.600}" },
          "glyph": { "$type": "color", "$value": "{color.primitive.gray.0}", "$description": "mine의 체크 표시·wheelchair 아이콘 글리프 색(3:1, d2 §5)" }
        },
        "slo": {
          "$description": "관제 패널 기준선 대비 상태. UI 요소라 3:1",
          "ok": { "$type": "color", "$value": "{color.primitive.green.700}", "$extensions": { "seed": "$color.bg.positive-solid" } },
          "burning": { "$type": "color", "$value": "{color.primitive.yellow.700}", "$extensions": { "seed": "$color.fg.warning" } },
          "breached": { "$type": "color", "$value": "{color.primitive.red.700}", "$extensions": { "seed": "$color.bg.critical-solid" } }
        }
      },
      "dark": {
        "$description": "관제 콘솔 기본. 소비자 웹·파트너는 시스템 설정을 따른다(추천 적용, 2026-10-09)",
        "surface": { "$type": "color", "$value": "{color.primitive-dark.gray.100}", "$extensions": { "seed": "$color.bg.layer-default" } },
        "surface-muted": { "$type": "color", "$value": "{color.primitive-dark.gray.200}", "$extensions": { "seed": "$color.bg.neutral-muted" } },
        "surface-basement": { "$type": "color", "$value": "{color.primitive-dark.gray.0}", "$extensions": { "seed": "$color.bg.layer-basement" } },
        "surface-raised": { "$type": "color", "$value": "{color.primitive-dark.gray.200}", "$extensions": { "seed": "$color.bg.layer-floating" } },
        "surface-disabled": { "$type": "color", "$value": "{color.primitive-dark.gray.300}", "$extensions": { "seed": "$color.bg.disabled" } },
        "border": { "$type": "color", "$value": "{color.primitive-dark.gray.400}", "$extensions": { "seed": "$color.stroke.neutral-weak" } },
        "border-input": { "$type": "color", "$value": "{color.primitive-dark.gray.800}", "$extensions": { "seed": "$color.stroke.neutral-solid" } },
        "border-primary": { "$type": "color", "$value": "{color.primitive.indigo.500}", "$extensions": { "seed": "$color.stroke.brand-solid", "override": "PEAKET 인디고(ADR-0040)" } },
        "text": { "$type": "color", "$value": "{color.primitive-dark.gray.1000}", "$extensions": { "seed": "$color.fg.neutral" } },
        "text-muted": { "$type": "color", "$value": "{color.primitive-dark.gray.800}", "$extensions": { "seed": "$color.fg.neutral-muted" } },
        "text-disabled": { "$type": "color", "$value": "{color.primitive-dark.gray.500}", "$extensions": { "seed": "$color.fg.disabled" } },
        "text-on-primary": { "$type": "color", "$value": "{color.primitive.gray.0}", "$extensions": { "seed": "$color.fg.on-brand-solid" } },
        "primary": { "$type": "color", "$value": "{color.primitive.indigo.500}", "$extensions": { "seed": "$color.bg.brand-solid", "override": "PEAKET 인디고" } },
        "primary-hover": { "$type": "color", "$value": "{color.primitive.indigo.600}", "$extensions": { "seed": "$color.bg.brand-solid-pressed", "override": "PEAKET 인디고" } },
        "primary-subtle": { "$type": "color", "$value": "{color.primitive.indigo.900}", "$extensions": { "seed": "$color.bg.brand-weak", "override": "PEAKET 인디고" } },
        "link": { "$type": "color", "$value": "{color.primitive.indigo.300}", "$extensions": { "seed": "$color.fg.brand", "override": "PEAKET 인디고" } },
        "success": { "$type": "color", "$value": "{color.primitive-dark.green.700}", "$extensions": { "seed": "$color.fg.positive" } },
        "success-subtle": { "$type": "color", "$value": "{color.primitive-dark.green.100}", "$extensions": { "seed": "$color.bg.positive-weak" } },
        "warning": { "$type": "color", "$value": "{color.primitive-dark.yellow.700}", "$extensions": { "seed": "$color.fg.warning" } },
        "warning-subtle": { "$type": "color", "$value": "{color.primitive-dark.yellow.100}", "$extensions": { "seed": "$color.bg.warning-weak" } },
        "danger": { "$type": "color", "$value": "{color.primitive-dark.red.700}", "$extensions": { "seed": "$color.fg.critical" } },
        "danger-subtle": { "$type": "color", "$value": "{color.primitive-dark.red.100}", "$extensions": { "seed": "$color.bg.critical-weak" } },
        "info-subtle": { "$type": "color", "$value": "{color.primitive-dark.blue.100}", "$extensions": { "seed": "$color.bg.informative-weak" } },
        "focus-ring": { "$type": "color", "$value": "{color.primitive.indigo.300}", "$extensions": { "seed": "$color.stroke.focus-ring", "override": "PEAKET 인디고" } },
        "seat": {
          "available": { "$type": "color", "$value": "{color.primitive-dark.green.700}", "$extensions": { "seed": "$color.fg.positive" } },
          "held-by-others": { "$type": "color", "$value": "{color.primitive-dark.gray.500}", "$extensions": { "seed": "$color.palette.gray-500" } },
          "mine": { "$type": "color", "$value": "{color.primitive.indigo.300}", "$extensions": { "override": "PEAKET 인디고" } },
          "sold": { "$type": "color", "$value": "{color.primitive-dark.gray.400}", "$extensions": { "seed": "$color.palette.gray-400" } },
          "unavailable": { "$type": "color", "$value": "{color.primitive-dark.gray.200}", "$extensions": { "seed": "$color.palette.gray-200" } },
          "wheelchair": { "$type": "color", "$value": "{color.primitive.magenta.300}" },
          "glyph": { "$type": "color", "$value": "{color.primitive-dark.gray.100}", "$description": "다크의 밝은 좌석색 위 글리프. 흰색은 2.03·2.20:1이라 쓰지 않는다(d2 §5)" }
        },
        "slo": {
          "ok": { "$type": "color", "$value": "{color.primitive-dark.green.700}", "$extensions": { "seed": "$color.fg.positive" } },
          "burning": { "$type": "color", "$value": "{color.primitive-dark.yellow.700}", "$extensions": { "seed": "$color.fg.warning" } },
          "breached": { "$type": "color", "$value": "{color.primitive-dark.red.700}", "$extensions": { "seed": "$color.fg.critical" } }
        }
      }
    }
  },
  "pattern": {
    "$description": "좌석 상태 패턴. Canvas에서는 TS 상수로 그린다(원문: Canvas 좌석맵은 CSS 변수를 못 쓰므로 TS 토큰 필요)",
    "seat": {
      "available": { "$type": "string", "$value": "solid" },
      "held-by-others": { "$type": "string", "$value": "diagonal-hatch" },
      "mine": { "$type": "string", "$value": "solid-with-check" },
      "sold": { "$type": "string", "$value": "cross-hatch" },
      "unavailable": { "$type": "string", "$value": "dotted" },
      "wheelchair": { "$type": "string", "$value": "solid-with-icon" }
    }
  },
  "typography": {
    "$description": "SEED 타이포 스케일(1rem = 16px). 크기와 같은 번호의 줄 높이를 짝으로 쓴다. 글꼴 스택은 SEED --seed-font-family이고 Windows용 Pretendard 가변 서브셋은 자체 호스팅한다(원문 6장, ADR-0040)",
    "font-family": {
      "sans": { "$type": "fontFamily", "$value": ["-apple-system", "BlinkMacSystemFont", "Apple SD Gothic Neo", "Pretendard Variable", "Pretendard", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "Noto Sans", "sans-serif", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"], "$extensions": { "seed": "--seed-font-family" } },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem", "$extensions": { "seed": "$font-size.t2" }, "$description": "12px" },
      "sm": { "$type": "dimension", "$value": "0.875rem", "$extensions": { "seed": "$font-size.t4" }, "$description": "14px" },
      "md": { "$type": "dimension", "$value": "1rem", "$extensions": { "seed": "$font-size.t5" }, "$description": "16px 본문 기준" },
