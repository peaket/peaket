{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@peaket/config/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": false
  },
  "include": ["src/sale-policy", "src/seatmap-checks", "src/safe-json.ts"]
}
