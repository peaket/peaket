{
  "name": "@peaket/ds",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "디자인 토큰 빌드와 공용 부품(docs/design/d2, ADR-0040)",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles/index.css",
    "./queue-room.css": "./src/styles/queue-room.css",
    "./tokens": "./src/gen/tokens.ts",
    "./icons": "./src/icons/index.tsx",
    "./poc/seed-layer-probe": "./src/poc/SeedLayerProbe.tsx",
    "./seed-layered-alias": "./scripts/seed-layered-alias.mjs",
    "./color-mode-script": "./scripts/color-mode-script.mjs",
    "./*": "./src/components/*/index.ts"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "tokens:lint": "node scripts/check-tokens.mjs",
    "notices": "node scripts/build-notices.mjs",
    "notices:check": "node scripts/build-notices.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-tokens.mjs --check && node --test"
  },
  "dependencies": {
    "@seed-design/css": "^3.1.0",
    "@seed-design/react-dialog": "2.0.2",
    "@tanstack/react-table": "^9.3.1",
    "chart.js": "^4.6.1",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@peaket/config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "style-dictionary": "^5.7.1",
    "typescript": "^7.0.2"
  }
}
