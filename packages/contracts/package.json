{
  "name": "@peaket/contracts",
  "private": true,
  "version": "0.0.0",
  "description": "계약 원본(docs/api/openapi.yaml·asyncapi.yaml)에서 만든 Zod 스키마와 TypeScript 타입, proto 계약(docs/api/proto)의 JSON 설명자. 게시하지 않고 workspace:로만 잇는다(ADR-0165, docs/api/guidelines.md §1)",
  "type": "module",
  "exports": {
    "./openapi/model": {
      "types": "./src/gen/openapi/model/index.ts",
      "development": "./src/gen/openapi/model/index.ts",
      "default": "./dist/openapi/model/index.js"
    },
    "./openapi/*": {
      "types": "./src/gen/openapi/*.ts",
      "development": "./src/gen/openapi/*.ts",
      "default": "./dist/openapi/*.js"
    },
    "./asyncapi": {
      "types": "./src/gen/asyncapi/model/index.ts",
      "development": "./src/gen/asyncapi/model/index.ts",
      "default": "./dist/asyncapi/model/index.js"
    },
    "./proto": {
      "types": "./src/gen/proto/index.ts",
      "development": "./src/gen/proto/index.ts",
      "default": "./dist/proto/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gen": "node scripts/generate.mjs",
    "gen:check": "node scripts/check-generated.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@peaket/config": "workspace:*",
    "@types/node": "^24.0.0",
    "orval": "^8.45.0",
    "protobufjs": "7.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
