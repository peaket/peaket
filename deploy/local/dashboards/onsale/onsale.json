{
  "uid": "peaket-onsale",
  "title": "온세일 공용",
  "description": "온세일 구간의 서비스 네 신호와 배포·장애 주입·운영 사건 주석. tools/local/dashboards.mjs가 만든다(손으로 고치지 않는다)",
  "tags": [
    "peaket",
    "onsale"
  ],
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "annotations": {
    "list": [
      {
        "name": "배포",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "{service_name=~\".+\"} | json | kind=\"deploy\"",
        "titleFormat": "배포 {{service}}",
        "textFormat": "{{version}}",
        "instant": false
      },
      {
        "name": "장애 주입",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "{service_name=~\".+\"} | json | kind=\"chaos\"",
        "titleFormat": "장애 주입 {{scenario}}",
        "textFormat": "{{target}}",
        "instant": false
      },
      {
        "name": "운영 사건",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "{service_name=\"ops-svc\"} | json | kind=\"ops_event\"",
        "titleFormat": "{{opsEvent}} {{stage}}",
        "textFormat": "회차 {{eventId}} · {{actorRole}}",
        "instant": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "custom",
        "query": "queue-svc,admission-ctrl,purchase-svc,payment-svc,ticket-svc,realtime-gw,identity-svc,trust-svc,ops-svc,core-svc,example-svc,v0-monolith",
        "options": [
          {
            "text": "queue-svc",
            "value": "queue-svc",
            "selected": true
          },
          {
            "text": "admission-ctrl",
            "value": "admission-ctrl",
            "selected": false
          },
          {
            "text": "purchase-svc",
            "value": "purchase-svc",
            "selected": false
          },
          {
            "text": "payment-svc",
            "value": "payment-svc",
            "selected": false
          },
          {
            "text": "ticket-svc",
            "value": "ticket-svc",
            "selected": false
          },
          {
            "text": "realtime-gw",
            "value": "realtime-gw",
            "selected": false
          },
          {
            "text": "identity-svc",
            "value": "identity-svc",
            "selected": false
          },
          {
            "text": "trust-svc",
            "value": "trust-svc",
            "selected": false
          },
          {
            "text": "ops-svc",
            "value": "ops-svc",
            "selected": false
          },
          {
            "text": "core-svc",
            "value": "core-svc",
            "selected": false
          },
          {
            "text": "example-svc",
            "value": "example-svc",
            "selected": false
          },
          {
            "text": "v0-monolith",
            "value": "v0-monolith",
            "selected": false
          }
        ],
        "current": {
          "text": "queue-svc",
          "value": "queue-svc"
        },
        "includeAll": false,
        "multi": true
      },
      {
        "name": "route",
        "label": "경로",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{service=~\"$service\"}, route)",
          "refId": "route"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "네 신호",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "지연",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", status_class!=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "성공 p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", status_class!=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "성공 p99"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.999, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", status_class!=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "성공 p99.9"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", status_class=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "실패 p50"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", status_class=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "실패 p99"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.999, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\", status_class=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "실패 p99.9"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "트래픽",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_server_request_duration_seconds_count{service=~\"$service\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "오류",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_errors_total{service=~\"$service\", route=~\"$route\"}[$__rate_interval])) or 0 * sum(rate(http_server_request_duration_seconds_count{service=~\"$service\", route=~\"$route\"}[$__rate_interval]))) / sum(rate(http_server_request_duration_seconds_count{service=~\"$service\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "5xx 비율"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_business_rejections_total{service=~\"$service\", route=~\"$route\"}[$__rate_interval])) or 0 * sum(rate(http_server_request_duration_seconds_count{service=~\"$service\", route=~\"$route\"}[$__rate_interval]))) / sum(rate(http_server_request_duration_seconds_count{service=~\"$service\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "정상 분기 거절 비율"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "포화도",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "이벤트 루프 지연.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (http_server_active_requests{service=~\"$service\", route=~\"$route\"})",
          "legendFormat": "처리 중 {{route}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pod) (nodejs_eventloop_lag_p99_seconds{app=~\"$service\"})",
          "legendFormat": "이벤트 루프 지연 p99 {{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "경로별",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "table",
      "title": "경로·응답 종류별 p99와 요청 수(최근 5분)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le, route, status_class) (rate(http_server_request_duration_seconds_bucket{service=~\"$service\", route=~\"$route\"}[5m])))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "legendFormat": "요청 수",
          "expr": "sum by (route, status_class) (increase(http_server_request_duration_seconds_count{service=~\"$service\", route=~\"$route\"}[5m]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "p99(초)",
              "Value #B": "요청 수(5분)"
            }
          }
        }
      ]
    }
  ]
}
