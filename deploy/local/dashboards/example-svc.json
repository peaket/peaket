{
  "uid": "peaket-svc-example-svc",
  "title": "서비스: example-svc",
  "description": "서비스 템플릿이 내는 지표의 템플릿 대시보드. tools/local/dashboards.mjs가 만든다(손으로 고치지 않는다)",
  "tags": [
    "peaket",
    "service-template"
  ],
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "경로",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{service=\"example-svc\"}, route)",
          "refId": "route"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "네 신호",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "지연",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"example-svc\", route=~\"$route\", status_class!=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "성공 p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"example-svc\", route=~\"$route\", status_class!=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "성공 p99"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.999, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"example-svc\", route=~\"$route\", status_class!=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "성공 p99.9"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"example-svc\", route=~\"$route\", status_class=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "실패 p50"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"example-svc\", route=~\"$route\", status_class=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "실패 p99"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.999, sum by (le) (rate(http_server_request_duration_seconds_bucket{service=\"example-svc\", route=~\"$route\", status_class=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "실패 p99.9"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "트래픽",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(http_server_request_duration_seconds_count{service=\"example-svc\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "오류",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_errors_total{service=\"example-svc\", route=~\"$route\"}[$__rate_interval])) or 0 * sum(rate(http_server_request_duration_seconds_count{service=\"example-svc\", route=~\"$route\"}[$__rate_interval]))) / sum(rate(http_server_request_duration_seconds_count{service=\"example-svc\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "5xx 비율"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_server_business_rejections_total{service=\"example-svc\", route=~\"$route\"}[$__rate_interval])) or 0 * sum(rate(http_server_request_duration_seconds_count{service=\"example-svc\", route=~\"$route\"}[$__rate_interval]))) / sum(rate(http_server_request_duration_seconds_count{service=\"example-svc\", route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "정상 분기 거절 비율"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "포화도",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "이벤트 루프 지연.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (http_server_active_requests{service=\"example-svc\", route=~\"$route\"})",
          "legendFormat": "처리 중 {{route}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (pod) (nodejs_eventloop_lag_p99_seconds{app=\"example-svc\"})",
          "legendFormat": "이벤트 루프 지연 p99 {{pod}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "경로별",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "table",
      "title": "경로·응답 종류별 p99와 요청 수(최근 5분)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le, route, status_class) (rate(http_server_request_duration_seconds_bucket{service=\"example-svc\", route=~\"$route\"}[5m])))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "legendFormat": "요청 수",
          "expr": "sum by (route, status_class) (increase(http_server_request_duration_seconds_count{service=\"example-svc\", route=~\"$route\"}[5m]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "p99(초)",
              "Value #B": "요청 수(5분)"
            }
          }
        }
      ]
    }
  ]
}
