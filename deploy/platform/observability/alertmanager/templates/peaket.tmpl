{{ define "peaket.slack.text" }}{{ range .Alerts }}*{{ .Labels.alertname }}* ({{ .Labels.severity }}{{ if .Labels.kind }}, {{ .Labels.kind }}{{ end }})
{{ if .Annotations.summary }}{{ .Annotations.summary }}{{ end }}
{{ if .Labels.event_id }}event_id: {{ .Labels.event_id }}{{ end }}
{{ if .Labels.journey }}journey: {{ .Labels.journey }}{{ end }}
{{ if .Labels.dependency }}dependency: {{ .Labels.dependency }}{{ end }}
{{ if .Annotations.runbook_url }}runbook: {{ .Annotations.runbook_url }}{{ else }}runbook: 런북 없음{{ end }}
