{
  "type": "record",
  "name": "PurchaseSessionEnded",
  "namespace": "peaket.trade",
  "doc": "구매 세션 종료. 토픽 trade.purchase-sessions, 키 eventId(회차). purchase-svc Redis Stream 릴레이에서 나간다.",
  "fields": [
    {
      "name": "eventId",
      "doc": "회차 ID",
      "type": "string"
    },
    {
      "name": "purchaseSessionId",
      "doc": "구매 세션 ID(OrderEvent·SeatEvent·HoldAttempt의 purchaseSessionId와 같은 값)",
      "type": "string"
    },
    {
      "name": "admissionJti",
      "type": "string"
    },
    {
      "name": "reason",
      "doc": "과금 없는 결제 실패는 구매 세션을 끝내지 않고 좌석맵으로 돌아간다(planning/03 §2.2 Paying → Active, POL-009, 2026-10-13 전수 점검)",
      "type": {
        "type": "enum",
        "name": "PurchaseSessionEndedReason",
        "default": "UNRECOGNIZED",
        "symbols": [
          "UNRECOGNIZED",
          "COMPLETED",
          "LEFT",
          "IDLE",
          "MAX_STAY"
        ]
      }
    },
    {
      "name": "endedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "eventKey",
      "doc": "중복 제거 키(ADR-0052). 같은 사건을 다시 보내면 같은 값",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    }
  ]
}
