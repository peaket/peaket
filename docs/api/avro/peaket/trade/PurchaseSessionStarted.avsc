{
  "type": "record",
  "name": "PurchaseSessionStarted",
  "namespace": "peaket.trade",
  "doc": "구매 세션 시작. 토픽 trade.purchase-sessions, 키 eventId(회차). purchase-svc Redis Stream 릴레이에서 나간다.",
  "fields": [
    {
      "name": "eventId",
      "doc": "회차 ID",
      "type": "string"
    },
    {
      "name": "purchaseSessionId",
      "doc": "구매 세션 ID(OrderEvent·SeatEvent·HoldAttempt의 purchaseSessionId와 같은 값)",
      "type": "string"
    },
    {
      "name": "admissionJti",
      "doc": "입장 토큰 jti → 입장 자리 식별",
      "type": "string"
    },
    {
      "name": "journeyId",
      "doc": "입장 토큰 클레임 jny의 여정 ID(조사용 추적 ID, UUIDv7). 조사 적재가 구매 세션을 여정에 잇고 분석 적재는 버린다(ADR-0171 결정 4, 추천 적용 2026-10-31)",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "startedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "maxStayUntil",
      "doc": "최대 체류 시각으로 점수 갱신",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "eventKey",
      "doc": "중복 제거 키(ADR-0052). 같은 사건을 다시 보내면 같은 값",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    }
  ]
}
