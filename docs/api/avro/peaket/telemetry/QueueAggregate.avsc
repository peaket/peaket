{
  "type": "record",
  "name": "QueueAggregate",
  "namespace": "peaket.telemetry",
  "doc": "대기열 1초 집계(진입 수, 빠진 번호, 입장 확정 수). 토픽 telemetry.queue, 키 '회차:파드'. queue-svc가 낸다.",
  "fields": [
    {
      "name": "eventId",
      "doc": "회차 ID",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "second",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "entries",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "removed",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "admissions",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "soonResponses",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "eventKey",
      "doc": "중복 제거 키(ADR-0052). 같은 사건을 다시 보내면 같은 값",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null
    },
    {
      "name": "schemaVersion",
      "doc": "메시지 형식 판",
      "type": [
        "null",
        "long"
      ],
      "default": null
    }
  ]
}
