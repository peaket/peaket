{
  "type": "record",
  "name": "TrustCandidate",
  "namespace": "peaket.telemetry",
  "doc": "대기 중 재평가 후보. 토픽 telemetry.trust-candidates, 키 pid. 재평가 작업자 trust-reassess가 낸다(ADR-0071·0099). 대기 중 재평가 후보(ADR-0071). 행동 요약값 원문·기기 가명은 싣지 않는다",
  "fields": [
    {
      "name": "eventId",
      "doc": "회차 ID",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "pid",
      "doc": "사람 식별값",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "pattern",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "TrustCandidatePattern",
          "default": "UNRECOGNIZED",
          "symbols": [
            "UNRECOGNIZED",
            "DEVICE_SHARE",
            "BEHAVIOR_REPLAY"
          ]
        }
      ],
      "default": null
    },
    {
      "name": "evidenceCount",
      "doc": "10분 안 같은 기기·같은 지문의 서로 다른 pid 수",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "windowStart",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "detectedAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "eventKey",
      "doc": "회차·pid·패턴·10분 칸에서 만든 값. 같은 후보를 다시 내도 같다",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null
    }
  ]
}
