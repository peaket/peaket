{
  "type": "record",
  "name": "HoldAttempt",
  "namespace": "peaket.telemetry",
  "doc": "홀드 시도 결과(409 경합 포함). 토픽 telemetry.purchase, 키 purchaseSessionId. purchase-svc가 홀드 요청마다 낸다. 홀드 요청 결과. 409 경합도 낸다(ADR-0052)",
  "fields": [
    {
      "name": "eventId",
      "doc": "회차 ID",
      "type": "string"
    },
    {
      "name": "purchaseSessionId",
      "type": "string"
    },
    {
      "name": "mode",
      "type": {
        "type": "enum",
        "name": "HoldAttemptMode",
        "default": "UNRECOGNIZED",
        "symbols": [
          "UNRECOGNIZED",
          "PICK",
          "AUTO"
        ]
      }
    },
    {
      "name": "tierId",
      "type": "string"
    },
    {
      "name": "sectionId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "result",
      "type": {
        "type": "enum",
        "name": "HoldAttemptResult",
        "default": "UNRECOGNIZED",
        "symbols": [
          "UNRECOGNIZED",
          "HELD",
          "CONFLICT",
          "LIMIT",
          "ERROR",
          "RECENTLY_RELEASED"
        ]
      }
    },
    {
      "name": "autoResult",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "HoldAttemptAutoResult",
          "default": "UNRECOGNIZED",
          "symbols": [
            "UNRECOGNIZED",
            "FIRST",
            "FIRST_SPLIT",
            "SECOND",
            "SECOND_SPLIT",
            "MANUAL_REQUIRED"
          ]
        }
      ],
      "default": null,
      "x-present-when": [
        {
          "mode": [
            "AUTO"
          ]
        }
      ]
    },
    {
      "name": "firstHeldInSession",
      "type": "boolean",
      "default": false,
      "doc": "그 구매 세션의 첫 HELD일 때 true. 관제 실시간 표가 첫 홀드 퍼널을 구매 세션마다 한 번 센다(ADR-0099)"
    },
    {
      "name": "retryNo",
      "type": "long"
    },
    {
      "name": "latencyMs",
      "type": "long"
    },
    {
      "name": "occurredAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "eventKey",
      "doc": "중복 제거 키(ADR-0052). 같은 사건을 다시 보내면 같은 값",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    }
  ]
}
