{
  "type": "record",
  "name": "HoldAttempt",
  "namespace": "peaket.telemetry",
  "doc": "홀드 시도 결과(409 경합 포함). 토픽 telemetry.purchase, 키 purchaseSessionId. purchase-svc가 홀드 요청마다 낸다. 홀드 요청 결과. 409 경합도 낸다(ADR-0052)",
  "fields": [
    {
      "name": "eventId",
      "doc": "회차 ID",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "purchaseSessionId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "mode",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "HoldAttemptMode",
          "default": "UNRECOGNIZED",
          "symbols": [
            "UNRECOGNIZED",
            "PICK",
            "AUTO"
          ]
        }
      ],
      "default": null
    },
    {
      "name": "tierId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "sectionId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "result",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "HoldAttemptResult",
          "default": "UNRECOGNIZED",
          "symbols": [
            "UNRECOGNIZED",
            "HELD",
            "CONFLICT",
            "LIMIT",
            "ERROR"
          ]
        }
      ],
      "default": null
    },
    {
      "name": "autoResult",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "HoldAttemptAutoResult",
          "default": "UNRECOGNIZED",
          "symbols": [
            "UNRECOGNIZED",
            "FIRST",
            "FIRST_SPLIT",
            "SECOND",
            "SECOND_SPLIT",
            "MANUAL_REQUIRED"
          ]
        }
      ],
      "default": null
    },
    {
      "name": "firstHeldInSession",
      "type": [
        "null",
        "boolean"
      ],
      "default": null,
      "doc": "그 구매 세션의 첫 HELD일 때 true. 관제 실시간 표가 첫 홀드 퍼널을 구매 세션마다 한 번 센다(ADR-0099)"
    },
    {
      "name": "retryNo",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "latencyMs",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "occurredAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "eventKey",
      "doc": "중복 제거 키(ADR-0052). 같은 사건을 다시 보내면 같은 값",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null
    }
  ]
}
