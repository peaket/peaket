{
  "type": "record",
  "name": "QueueEntryRecord",
  "namespace": "peaket.telemetry",
  "doc": "사람별 대기 기록. 토픽 telemetry.queue, 키 pid. queue-svc가 대기가 끝날 때 한 건 낸다. 사람별 대기 기록. 대기가 입장 확정·빠진 번호·로비 참가 취소·그 회차의 판매 종료나 매진으로 끝날 때 한 건(ADR-0052. 매진은 ADR-0122. 판매가 온세일 윈도우로 끝나지 않는 것은 ADR-0063 결정 11, 판매 종료 = 공연 시작 24시간 전은 ADR-0064)",
  "fields": [
    {
      "name": "eventId",
      "doc": "회차 ID",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "queueEntryId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "pid",
      "doc": "분석 저장소는 적재 때 회차별 가명으로 바꾼다",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "number",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "entryMode",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "QueueEntryRecordEntryMode",
          "default": "UNRECOGNIZED",
          "symbols": [
            "UNRECOGNIZED",
            "LOBBY",
            "AFTER_OPEN"
          ]
        }
      ],
      "default": null
    },
    {
      "name": "enteredAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "firstEtaSec",
      "doc": "처음 보인 예상 대기(초)",
      "type": [
        "null",
        "long"
      ],
      "default": null
    },
    {
      "name": "turnAt",
      "doc": "차례가 온 시각",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "admittedAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "admissionJti",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "removedAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "removeReason",
      "doc": "NO_CONFIRM 차례 뒤 15분 안에 입장 확정 없음, LEFT 대기 취소·로비 참가 취소, BLOCKED 추가 검증 실패·이의 기각, SALE_END 차례 전(또는 차례 뒤 입장 확정 전)에 그 회차의 판매 종료(공연 시작 24시간 전 = starts_at − 24시간, 소유자 결정 2026-10-14, ADR-0064. 온세일 윈도우 종료가 아님, ADR-0063 결정 11. 예전 이름 WINDOW_END), DUPLICATE 1인 1순번 위반 무효(입장 확정 때 다른 대기표로 이미 입장, ADR-0056), SOLD_OUT 차례 전(또는 차례 뒤 입장 확정 전)에 그 회차가 매진(회차 판매 상태 SOLD_OUT, ADR-0122. 일시 매진 ALL_HELD에는 끝나지 않음. 판매 종료와 가르려고 따로 둔다, 기술 검토 낮음-130)",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "QueueEntryRecordRemoveReason",
          "default": "UNRECOGNIZED",
          "symbols": [
            "UNRECOGNIZED",
            "NO_CONFIRM",
            "LEFT",
            "BLOCKED",
            "SALE_END",
            "DUPLICATE",
            "SOLD_OUT"
          ]
        }
      ],
      "default": null
    },
    {
      "name": "verifyRoute",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "QueueEntryRecordVerifyRoute",
          "default": "UNRECOGNIZED",
          "symbols": [
            "UNRECOGNIZED",
            "DIRECT",
            "CHALLENGE_PASSED",
            "CHALLENGE_FAILED",
            "BLOCKED"
          ]
        }
      ],
      "default": null
    },
    {
      "name": "eventKey",
      "doc": "중복 제거 키(ADR-0052). 같은 사건을 다시 보내면 같은 값",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null
    }
  ]
}
