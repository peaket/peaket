{
  "type": "record",
  "name": "SettingChanged",
  "namespace": "peaket.control",
  "doc": "운영 설정 사건. 토픽 control.settings. ops-svc가 내고 모든 서비스가 구독한다(POL-021, ADR-0044).",
  "fields": [
    {
      "name": "commandId",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "key",
      "doc": "FEATURE_FLAG는 비핵심 기능 끄기(명령 9), AUTOMATION_STOP은 입장 제어 자동화 긴급 정지(명령 11, admission-ctrl은 TCP 대역 외로도 받음). PG_ASSIGNMENT는 공연 결제사 지정(명령 12). 결제사 전환은 DEGRADED_MODE의 PAYMENT_PG_FALLBACK 값(ADR-0044)",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "SettingChangedKey",
          "symbols": [
            "BOT_LEVEL",
            "LOG_LEVEL",
            "FEATURE_FLAG",
            "DEGRADED_MODE",
            "LOBBY_BANNER",
            "PG_ASSIGNMENT",
            "AUTOMATION_STOP"
          ]
        }
      ],
      "default": null
    },
    {
      "name": "scope",
      "doc": "PLATFORM 또는 공연 ID. 결제사 지정·전환은 공연 단위",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "value",
      "doc": "키마다 정한 값. BOT_LEVEL은 {level: RELAXED|STANDARD|AGGRESSIVE(완화·기본·강화), reassessMode: OFF|SHADOW|ENFORCE(대기 중 재평가 끔·그림자·적용, 기본 SHADOW)}의 JSON이다. 재평가 모드는 강도와 따로 고르는 명령 5의 별도 매개변수이고, ENFORCE로 바꾸는 것은 commander만 한다(추천 적용 2026-10-20, ADR-0073)",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "expiresAt",
      "doc": "로그 레벨 30분 자동 복귀 등",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "actor",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "occurredAt",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-millis"
        }
      ],
      "default": null
    },
    {
      "name": "eventKey",
      "doc": "중복 제거 키(ADR-0052). 같은 사건을 다시 보내면 같은 값",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null
    },
    {
      "name": "schemaVersion",
      "doc": "메시지 형식 판",
      "type": [
        "null",
        "long"
      ],
      "default": null
    }
  ]
}
