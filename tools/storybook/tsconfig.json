{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../packages/config/tsconfig/base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@storybook/react-vite": [
        "./node_modules/@storybook/react-vite/dist/index.d.ts"
      ]
    }
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "../../packages/ds/src/**/*.stories.tsx"
  ]
}
