      "entrySeconds": 10,
      "admitPerSecond": 28,
      "errorRateLimit": 0.001,
      "minTrials": 2995,
      "errorRateSource": "NFR-001·Q-T2 0.1%",
      "judge": "NFR-027",
      "commands": [
        "node loadtest/run.mjs v1 soak --target queue-svc --rate 500 --out .cache/peaket-f085/{day}-queue-r{round}"
      ],
      "artifacts": ["series.ndjson", "errors.json", "summary.json", "records.ndjson", "probe.json", "restarts.json", "host.json", "run.json"]
    },
    {
      "id": "purchase-svc",
      "load": "http",
      "rate": 1000,
