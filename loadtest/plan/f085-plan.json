      "seatsPerOrder": 2,
      "errorRateLimit": 0.0005,
      "minTrials": 5991,
      "errorRateSource": "NFR-006 완료율 99.95%·P-T5 0.05% 이하",
      "judge": "NFR-027",
      "commands": [
        "node loadtest/run.mjs v1 soak --target payment-svc --rate 150 --out .cache/peaket-f085/{day}-payment-r{round}"
      ],
      "artifacts": ["series.ndjson", "errors.json", "summary.json", "records.ndjson", "probe.json", "restarts.json", "host.json", "run.json"]
    },
    {
      "id": "realtime-gw",
      "load": "ws",
      "rate": 63,
      "rateSource": "S-T12 설계 5,000 연결·125/s의 50%(연결 2,500, 홀드 63/s)",
      "connections": 2500,
      "holdRate": 63,
      "errorRateLimit": 0.001,
      "minTrials": 2995,
      "errorRateSource": "[가정, F-08-5 계획]",
      "judge": "NFR-027",
      "commands": [
        "node loadtest/run.mjs v1 soak --target realtime-gw --rate 2500 --connections 2500 --hold-rate 63 --out .cache/peaket-f085/{day}-realtime-r{round}"
