      "judge": "NFR-027",
      "commands": [
        "node loadtest/run.mjs v1 soak --target purchase-svc --rate 1000 --out .cache/peaket-f085/{day}-purchase-r{round}"
      ],
      "artifacts": ["series.ndjson", "errors.json", "summary.json", "records.ndjson", "probe.json", "restarts.json", "host.json", "run.json"]
    },
    {
      "id": "payment-svc",
      "load": "http",
      "rate": 150,
