  "leak": {
    "target": "purchase-svc",
    "variant": "db-conn",
    "intervalMin": 10,
    "connectionsPerHour": 6,
    "fdStartMax": 600,
    "dbStart": 16,
    "dbMax": 100,
    "applicationName": "purchase-svc-leak",
    "patch": "loadtest/soak/db-conn-leak.patch",
    "commands": [
      "git apply loadtest/soak/db-conn-leak.patch",
      "docker build -f services/purchase-svc/Dockerfile -t peaket/purchase-svc:soak-leak .",
      "node loadtest/run.mjs v1 soak --target purchase-svc --rate 1000 --leak db-conn --out .cache/peaket-f085/{day}-purchase-leak-r{round}"
    ]
  },
  "report": "docs/review/measurements/F-08-5-soak.md",
  "not_included": [
