@@ -0,0 +1,58 @@
+// F-08-5 V-T10 누수 주입 판(로컬 전용). 이 파일은 저장소에 커밋하지 않고
+// loadtest/soak/db-conn-leak.patch를 임시 사본에 적용할 때만 생긴다.
+import { Client } from 'pg';
+
+/** 6시간을 채우면서 시간당 6개를 새게 하는 누수율(분) */
+export const SOAK_LEAK_INTERVAL_MIN = 10;
+export const SOAK_LEAK_CONNECTIONS_PER_HOUR = 6;
+export const SOAK_LEAK_APPLICATION_NAME = 'purchase-svc-leak';
+
+export interface SoakLeakOptions {
+  env: Record<string, string | undefined>;
+  url: string;
+}
+
+/**
+ * PEAKET_SOAK_LEAK=db-conn이고 PEAKET_ENV=local일 때만 10분마다 PostgreSQL 연결을
+ * 새로 맺고 끝내지 않는다. release·운영에서는 모드를 켜면 시작을 거부한다.
+ * 돌려주는 함수는 반복을 멈춘다.
+ */
+export function startSoakLeak({ env, url }: SoakLeakOptions): () => void {
+  const mode = env.PEAKET_SOAK_LEAK;
+  if (!mode) return () => {};
+  if (env.PEAKET_ENV !== 'local') {
+    throw new Error('PEAKET_SOAK_LEAK는 PEAKET_ENV=local에서만 쓸 수 있다');
+  }
+  if (mode !== 'db-conn') throw new Error(`모르는 PEAKET_SOAK_LEAK: ${mode}`);
+
+  let stopped = false;
+  const intervalMin = SOAK_LEAK_INTERVAL_MIN;
+  const timer = setInterval(() => {
+    if (stopped) return;
+    const client = new Client({
+      connectionString: url,
+      application_name: SOAK_LEAK_APPLICATION_NAME,
+    });
+    // 일부러 end()를 부르지 않는다. DB 연결 수와 열린 FD가 시간당 6개씩 는다.
+    void client.connect().catch(() => {});
+  }, intervalMin * 60_000);
+  timer.unref?.();
+  return () => {
+    stopped = true;
+    clearInterval(timer);
+  };
+}
