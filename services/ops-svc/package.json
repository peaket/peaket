{
  "name": "@peaket/ops-svc",
  "private": true,
  "version": "0.0.0",
  "description": "ops-svc. 관제 명령 접수·2인 승인·불변 감사 로그(해시 체인)와 CS 처리함 건 접수의 최소 골격이다. GAT-110 회차 취소·일괄 환불의 나머지와 제어 gRPC 전달은 후속이다.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import @peaket/platform/telemetry/register dist/main.js",
    "migrate": "node scripts/migrate.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@peaket/contracts": "workspace:*",
    "@peaket/platform": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@peaket/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
