{
  "name": "@peaket/v0-monolith",
  "private": true,
  "version": "0.0.0",
  "description": "v0 모놀리스. K1~K10을 v1과 견주는 '처음 만들 법한 단순한 설계'의 비교 기준선이다. 모듈 경계는 v1 서비스와 같다(docs/architecture.md §9.3, ADR-0096). 대기열 v0(queue, wbs 1.1.1)와 좌석 v0(inventory와 좌석맵 화면, wbs 1.1.2)가 있다",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import @peaket/platform/telemetry/register dist/main.js",
    "migrate": "node scripts/migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@peaket/platform": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1",
    "redis": "6.3.0",
    "reflect-metadata": "^0.2.2",
    "ws": "8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@peaket/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
