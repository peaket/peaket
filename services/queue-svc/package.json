{
  "name": "@peaket/queue-svc",
  "private": true,
  "version": "0.0.0",
  "description": "queue-svc. 지금은 사전 검증 토큰 발급과 오픈 뒤 진입(대기표 발급)만 있다(docs/features/queue-admission.md §3, BUILD_ORDER PRF-050). 묶음 셔플은 PRF-060, 대기 상태 파일은 PRF-070, 입장 확정은 PRF-110이 더한다",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import @peaket/platform/telemetry/register dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@peaket/platform": "workspace:*",
    "fastify": "^5.12.7",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@peaket/config": "workspace:*",
    "@peaket/contracts": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
