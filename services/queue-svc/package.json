{
  "name": "@peaket/queue-svc",
  "private": true,
  "version": "0.0.0",
  "description": "queue-svc. 사전 검증 토큰 발급과 오픈 뒤 진입(대기표 발급, docs/features/queue-admission.md §3, BUILD_ORDER PRF-050), 묶음 셔플(PRF-060), 대기 상태 파일(PRF-070), 입장 확정과 입장 토큰(§6, PRF-110)이 있다",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import @peaket/platform/telemetry/register dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "sim": "vitest run --config vitest.sim.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1159.0",
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@peaket/contracts": "workspace:*",
    "@peaket/platform": "workspace:*",
    "@peaket/shuffle": "workspace:*",
    "fastify": "^5.12.7",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@peaket/config": "workspace:*",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
