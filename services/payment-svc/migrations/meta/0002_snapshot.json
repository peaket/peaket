          "name": "payment_method_ref_card_bin_check",
          "value": "(\"payment\".\"payment_method_ref\" IS NULL) = (\"payment\".\"card_bin\" IS NULL)"
        },
        "payment_failure_category_check": {
          "name": "payment_failure_category_check",
