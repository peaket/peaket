        "payment_unknown_next_query_check": {
          "name": "payment_unknown_next_query_check",
          "value": "\"payment\".\"status\" <> 'UNKNOWN' OR \"payment\".\"next_query_at\" IS NOT NULL"
        },
        "payment_status_check": {
          "name": "payment_status_check",
          "value": "\"payment\".\"status\" IN ('ACCEPTED', 'AWAITING_DEPOSIT', 'APPROVED', 'UNKNOWN', 'FAILED', 'PARTIAL_CANCELED', 'CANCELED')"
        },
        "payment_pg_check": {
