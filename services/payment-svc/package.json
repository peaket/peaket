{
  "name": "@peaket/payment-svc",
  "private": true,
  "version": "0.0.0",
  "description": "payment-svc. 결제 모듈의 결제 포트·시뮬레이터 어댑터·공통 계약 시험, 프로세스(gRPC·릴레이), 승인 명령 접수 ConfirmPayment와 결과 조회 BatchGetPayments(BUILD_ORDER PRF-180)가 있다. 승인 실행기와 결제사 호출은 PRF-181~184다. 결제 포트·시뮬레이터는 공개 파일(index.ts)로 v0 모놀리스가 가져다 쓴다(@peaket/payment-svc/payment, docs/features/payment.md §13)",
  "type": "module",
  "exports": {
    "./payment": {
      "types": "./dist/modules/payment/index.d.ts",
      "default": "./dist/modules/payment/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:lib": "tsc -p tsconfig.lib.json",
    "start": "node --import @peaket/platform/telemetry/register dist/main.js",
    "migrate": "node scripts/migrate.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@peaket/contracts": "workspace:*",
    "@peaket/platform": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@peaket/config": "workspace:*",
    "@peaket/pg-simulator": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
