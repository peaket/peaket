{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@peaket/config/tsconfig/base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@peaket/platform": ["../../packages/platform/src/index.ts"],
      "@peaket/pg-simulator": ["../pg-simulator/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
